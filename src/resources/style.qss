QLabel#instrumentIcon {
    background-color: #f3f4f6;
    border-radius: 4px;
    margin: 3px 10px;
    padding: 2px;
}

QStatusBar {
    background-color: palette(window);
    border-top: 1px solid palette(midlight);
}

QStatusBar::item {
    border: none;
}

QFrame#chartPanel {
    background-color: palette(base);
}
QWidget#chartToolbar {
    background-color: palette(window);
    border-bottom: 1px solid palette(mid);
}
QWidget#chartToolbar QComboBox {
    padding: 4px 6px;
    min-height: 20px;
}
QWidget#chartToolbar QToolButton {
    border: 1px solid palette(mid);
    border-radius: 3px;
    padding: 5px 7px;
    background-color: palette(window);
    color: palette(window-text);
}
QWidget#chartToolbar QToolButton:enabled:hover {
    background-color: palette(mid);
}
QWidget#chartToolbar QToolButton:checked {
    border-color: palette(highlight);
    background-color: palette(alternate-base);
}
QWidget#chartToolbar QToolButton:checked:enabled:hover {
    background-color: palette(mid);
}
QWidget#chartToolbar QToolButton:enabled:pressed {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}
QWidget#chartEmpty {
    background-color: palette(base);
}
QWidget#chartEmpty QLabel {
    color: palette(placeholder-text);
}
QLabel#chartEmptyTitle {
    color: palette(text);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}
QLabel#chartStatus {
    color: palette(placeholder-text);
    background-color: palette(window);
    border-top: 1px solid palette(mid);
    padding: 5px 10px;
    font-size: 11px;
}

QPushButton, QToolButton {
    border: 1px solid palette(mid);
    border-radius: 3px;
    padding: 5px 7px;
    background-color: palette(window);
    color: palette(window-text);
}
QPushButton:focus, QToolButton:focus {
    border-color: palette(mid);
    outline: none;
}
QPushButton:enabled:hover, QToolButton:enabled:hover {
    background-color: palette(mid);
}
QPushButton:enabled:pressed, QToolButton:enabled:pressed {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}
QPushButton:checked, QToolButton:checked {
    border-color: palette(highlight);
    background-color: palette(alternate-base);
}
QPushButton:checked:focus, QToolButton:checked:focus {
    border-color: palette(highlight);
}

QMenuBar {
    border: none;
    margin: 0px;
    background-color: palette(window);
    color: palette(window-text);
    border-bottom: 1px solid #4b535f;
}
QMenuBar::item {
    padding: 5px 10px;
    background-color: transparent;
}
QMenuBar::item:selected, QMenuBar::item:hover {
    background-color: palette(mid);
    color: palette(window-text);
}
QMenuBar::item:pressed {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QTabWidget#workspaceTabs::pane {
    border: none;
}
QTabWidget#workspaceTabs QTabBar::tab {
    background-color: palette(window);
    color: palette(window-text);
    border: 1px solid palette(mid);
    padding: 0px 8px;
    min-width: 96px;
    height: 26px;
}
QTabWidget#workspaceTabs QTabBar::tab:selected {
    background-color: palette(base);
    border-bottom: 2px solid palette(highlight);
}
QTabWidget#workspaceTabs QTabBar::tab:hover {
    background-color: palette(mid);
}

QToolButton#newWorkspaceButton {
    margin: 0px;
    padding: 0px;
    border: none;
    border-radius: 0px;
    background-color: palette(window);
}
QToolButton#newWorkspaceButton:enabled:hover {
    background-color: palette(mid);
}
QToolButton#workspaceTabClose {
    padding: 0px;
    margin: 0px;
    border: none;
    background-color: transparent;
}
QToolButton#workspaceTabClose:enabled:hover {
    background-color: palette(midlight);
}

QMenu {
    background-color: palette(window);
    color: palette(window-text);
    border: 1px solid palette(mid);
    padding: 4px 0px;
}
QMenu::item {
    padding: 5px 24px;
    background-color: transparent;
}
QMenu::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}
QMenu::separator {
    height: 1px;
    background-color: palette(mid);
    margin: 4px 8px;
}

QListWidget#settingsCategories::item:selected {
    background-color: palette(alternate-base);
    color: palette(text);
}
QListWidget#settingsCategories::item:hover {
    background-color: palette(midlight);
    color: palette(text);
}

QLabel#instrumentListHint {
    color: palette(placeholder-text);
    padding-top: 3px;
    font-size: 11px;
}

QToolButton#newWorkspaceButton:enabled:pressed, QToolButton#workspaceTabClose:enabled:pressed {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QFrame#bookDepthPanel, QFrame#bookDepthPanel QTableWidget {
    background-color: palette(base);
    color: palette(text);
}
QLabel#bookLatest {
    background-color: palette(alternate-base);
    color: palette(text);
    border-top: 1px solid palette(mid);
    border-bottom: 1px solid palette(mid);
    padding: 3px;
    font-size: 18px;
    font-weight: bold;
}
QLabel#bookStatus {
    color: palette(placeholder-text);
    padding: 3px;
}

QToolButton#chartAutoScale {
    padding: 0px;
    border-radius: 3px;
    font-weight: 600;
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
}
QToolButton#chartAutoScale:checked {
    border-color: palette(text);
    background-color: palette(text);
    color: palette(base);
}
QToolButton#chartAutoScale:enabled:hover {
    background-color: palette(mid);
}
QToolButton#chartAutoScale:checked:enabled:hover {
    background-color: palette(window-text);
    border-color: palette(highlight);
}
QToolButton#chartAutoScale:enabled:pressed {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}


QTableWidget#selectionTable {
    background-color: palette(base);
    alternate-background-color: palette(alternate-base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}
QTableWidget#selectionTable::item {
    padding: 5px 8px;
    border-bottom: 1px solid palette(midlight);
    border-right: 1px solid palette(mid);
}
QTableWidget#selectionTable::item:hover {
    background-color: palette(midlight);
    color: palette(text);
}
QTableWidget#selectionTable::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}
QDialog#listManagerDialog QLineEdit {
    padding: 7px 9px;
    border: 1px solid palette(mid);
    border-radius: 4px;
    background-color: palette(base);
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}
QDialog#listManagerDialog QLineEdit:focus {
    border-color: palette(highlight);
}
QDialog#listManagerDialog QLabel#selectionCount {
    color: palette(placeholder-text);
}
QDialog#listManagerDialog QPushButton {
    padding: 7px 12px;
    min-height: 18px;
    background-color: palette(window);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 4px;
}
QDialog#listManagerDialog QPushButton:enabled:hover {
    background-color: palette(midlight);
    border-color: palette(highlight);
}
QDialog#listManagerDialog QPushButton:enabled:pressed {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}
QDialog#listManagerDialog QPushButton:disabled {
    color: palette(placeholder-text);
    border-color: palette(midlight);
}

QDateEdit#historyDate {
    min-width: 116px;
    padding: 4px 6px;
    border: 1px solid palette(mid);
    border-radius: 4px;
    color: palette(text);
    background: palette(base);
}
QDateEdit#historyDate:hover, QDateEdit#historyDate:focus {
    border-color: palette(highlight);
}
QCalendarWidget#historyCalendar QWidget#qt_calendar_navigationbar {
    background: palette(window);
    padding: 3px;
}
QCalendarWidget#historyCalendar QToolButton {
    padding: 5px 7px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: palette(window-text);
    background: palette(window);
}
QCalendarWidget#historyCalendar QToolButton:enabled:pressed {
    background: palette(midlight);
}
QCalendarWidget#historyCalendar QToolButton#qt_calendar_prevmonth,
QCalendarWidget#historyCalendar QToolButton#qt_calendar_nextmonth {
    min-width: 16px;
    font-size: 16px;
    padding: 1px 5px;
}
QCalendarWidget#historyCalendar QToolButton:disabled {
    color: palette(placeholder-text);
}
QCalendarWidget#historyCalendar QTableView {
    background: palette(base);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
    outline: 0;
}
QFrame#historyDayHover {
    background: palette(highlight);
    border-radius: 3px;
}
