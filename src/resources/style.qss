
/* Compact Qt Widgets Style */

/* Buttons */
QPushButton, QToolButton {
    padding: 2px 5px;
    margin: 0px;
    border-radius: 0px;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 2px;
    margin: 0px;
    border-radius: 0px;
}

/* Numeric inputs */
QSpinBox, QDoubleSpinBox {
    padding: 1px 2px;
    margin: 0px;
    border-radius: 0px;
}

/* Combo boxes */
QComboBox {
    padding: 2px 4px;
    margin: 0px;
    border-radius: 0px;
}

/* Checkboxes and radio buttons */
QCheckBox, QRadioButton {
    spacing: 3px;
    margin: 0px;
}

/* Tabs */
QTabBar::tab {
    padding: 3px 8px;
    margin: 0px;
    border-radius: 0px;
}

/* Group boxes */
QGroupBox {
    margin-top: 8px;
    padding: 3px;
    border-radius: 0px;
}

/* Menus */
QMenu::item {
    padding: 3px 12px;
}

QMenuBar::item {
    padding: 2px 6px;
}

/* Tables */
QHeaderView::section {
    padding: 2px 4px;
}

QTableView, QTableWidget,
QTreeView, QTreeWidget,
QListView, QListWidget {
    margin: 0px;
    border-radius: 0px;
}

/* Scrollbars */
QScrollBar {
    margin: 0px;
}

/* Progress bars */
QProgressBar {
    padding: 0px;
    border-radius: 0px;
}

/* Tooltips */
QToolTip {
    padding: 2px 4px;
    border-radius: 0px;
}
