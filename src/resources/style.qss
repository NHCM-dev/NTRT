
QLabel#instrumentIcon {
    background-color: #f3f4f6;
    border-radius: 4px;
    margin: 3px 10px;
    padding: 2px;
}

QWidget#workspaceNavigation QPushButton {
    background-color: palette(window);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 5px 6px;
}
QWidget#workspaceNavigation QPushButton:hover:enabled {
    background-color: palette(mid);
    border-color: palette(midlight);
}
QWidget#workspaceNavigation QPushButton:checked {
    background-color: palette(alternate-base);
    border-color: palette(highlight);
}
QWidget#workspaceNavigation QPushButton:checked:hover {
    background-color: palette(mid);
}
QWidget#workspaceNavigation QPushButton:disabled {
    color: palette(disabled, window-text);
    border-color: palette(dark);
}

QStatusBar {
    background-color: palette(window);
    border-top: 1px solid palette(midlight);
}

QStatusBar::item {
    border: none;
}
