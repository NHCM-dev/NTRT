file(MAKE_DIRECTORY "${DEST}/platforms")
file(COPY "${QT_CORE}" "${QT_GUI}" "${QT_WIDGETS}" "${QT_NETWORK}" "${QT_WEBSOCKETS}" DESTINATION "${DEST}")
file(COPY "${QT_PLATFORM}" DESTINATION "${DEST}/platforms")
file(MAKE_DIRECTORY "${DEST}/imageformats")
file(COPY "${QT_ICO}" DESTINATION "${DEST}/imageformats")
if(QT_TLS)
    file(MAKE_DIRECTORY "${DEST}/tls")
    file(COPY "${QT_TLS}" DESTINATION "${DEST}/tls")
endif()
# Scan only these libraries: there is no application executable on a fresh build.
set(APP "")
set(deployed_libraries)
foreach(library IN ITEMS QT_CORE QT_GUI QT_WIDGETS QT_NETWORK QT_WEBSOCKETS)
    get_filename_component(name "${${library}}" NAME)
    list(APPEND deployed_libraries "${DEST}/${name}")
endforeach()
foreach(plugin IN ITEMS QT_PLATFORM QT_ICO QT_TLS)
    if(${plugin})
        get_filename_component(name "${${plugin}}" NAME)
        if(plugin STREQUAL "QT_PLATFORM")
            set(folder platforms)
        elseif(plugin STREQUAL "QT_ICO")
            set(folder imageformats)
        else()
            set(folder tls)
        endif()
        list(APPEND deployed_libraries "${DEST}/${folder}/${name}")
    endif()
endforeach()
if(MINGW)
    include("${CMAKE_CURRENT_LIST_DIR}/DeployRuntime.cmake")
endif()
