# CMake honors an explicitly configured compiler before performing discovery.
if(CMAKE_CXX_COMPILER OR DEFINED ENV{CXX} OR NOT CMAKE_HOST_WIN32)
    return()
endif()

set(_mingw_bins)
set(_clang_bins)
foreach(root IN ITEMS "$ENV{MSYS2_ROOT}" "$ENV{SystemDrive}/msys64" "C:/msys64")
    if(root)
        list(APPEND _mingw_bins "${root}/ucrt64/bin" "${root}/mingw64/bin")
        list(APPEND _clang_bins "${root}/clang64/bin")
    endif()
endforeach()
find_program(_ntrt_clangxx NAMES clang++ HINTS ${_clang_bins} NO_DEFAULT_PATH)
if(NOT _ntrt_clangxx)
    find_program(_ntrt_clangxx NAMES clang++)
endif()
if(_ntrt_clangxx)
    execute_process(COMMAND "${_ntrt_clangxx}" -dumpmachine OUTPUT_VARIABLE _target OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_target MATCHES "(mingw32|windows-gnu)$")
        get_filename_component(_bin "${_ntrt_clangxx}" DIRECTORY)
        find_program(_ntrt_clang NAMES clang HINTS "${_bin}" NO_DEFAULT_PATH REQUIRED)
        set(CMAKE_C_COMPILER "${_ntrt_clang}" CACHE FILEPATH "")
        set(CMAKE_CXX_COMPILER "${_ntrt_clangxx}" CACHE FILEPATH "")
        return()
    endif()
endif()

find_program(_ntrt_clang_cl NAMES clang-cl HINTS "$ENV{ProgramFiles}/LLVM/bin")
if(_ntrt_clang_cl AND ((DEFINED ENV{INCLUDE} AND DEFINED ENV{LIB}) OR
    EXISTS "$ENV{SystemDrive}/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"))
    include("${CMAKE_CURRENT_LIST_DIR}/MsvcEnvironment.cmake")
    ntrt_load_msvc_environment()
    set(CMAKE_C_COMPILER "${_ntrt_clang_cl}" CACHE FILEPATH "")
    set(CMAKE_CXX_COMPILER "${_ntrt_clang_cl}" CACHE FILEPATH "")
    return()
endif()

find_program(_ntrt_gxx NAMES g++ HINTS ${_mingw_bins} NO_DEFAULT_PATH)
if(NOT _ntrt_gxx)
    find_program(_ntrt_gxx NAMES g++)
endif()
if(_ntrt_gxx)
    execute_process(COMMAND "${_ntrt_gxx}" -dumpmachine OUTPUT_VARIABLE _target OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_target MATCHES "mingw32$")
        get_filename_component(_bin "${_ntrt_gxx}" DIRECTORY)
        find_program(_ntrt_gcc NAMES gcc HINTS "${_bin}" NO_DEFAULT_PATH REQUIRED)
        set(CMAKE_C_COMPILER "${_ntrt_gcc}" CACHE FILEPATH "")
        set(CMAKE_CXX_COMPILER "${_ntrt_gxx}" CACHE FILEPATH "")
        return()
    endif()
endif()

find_program(_ntrt_cl NAMES cl)
if(_ntrt_cl OR EXISTS "$ENV{SystemDrive}/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe")
    include("${CMAKE_CURRENT_LIST_DIR}/MsvcEnvironment.cmake")
    ntrt_load_msvc_environment()
    find_program(_ntrt_cl NAMES cl REQUIRED)
    set(CMAKE_C_COMPILER "${_ntrt_cl}" CACHE FILEPATH "")
    set(CMAKE_CXX_COMPILER "${_ntrt_cl}" CACHE FILEPATH "")
    return()
endif()

message(FATAL_ERROR "No Windows C++ compiler detected. Install MSYS2 MinGW / CLANG64 or Visual Studio C++ Build Tools.")
