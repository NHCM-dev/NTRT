# Initialize the Windows SDK and MSVC libraries for Ninja's cl/clang-cl build.
# Save the environment so a later --build works from a regular terminal.
function(ntrt_load_msvc_environment)
    if(NOT DEFINED ENV{INCLUDE} OR NOT DEFINED ENV{LIB})
        set(vswhere "$ENV{SystemDrive}/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe")
        if(NOT EXISTS "${vswhere}")
            message(FATAL_ERROR "Install Visual Studio C++ Build Tools and the Windows SDK for cl or clang-cl.")
        endif()
        execute_process(COMMAND "${vswhere}" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
            -property installationPath OUTPUT_VARIABLE installation OUTPUT_STRIP_TRAILING_WHITESPACE)
        set(setup "${installation}/VC/Auxiliary/Build/vcvars64.bat")
        if(NOT EXISTS "${setup}")
            message(FATAL_ERROR "No Visual Studio x64 C++ build tools found.")
        endif()
        set(ENV{NTRT_VCVARS} "\"${setup}\"")
        execute_process(COMMAND cmd.exe /d /c "call %NTRT_VCVARS% >nul && set"
            OUTPUT_VARIABLE environment RESULT_VARIABLE result)
        unset(ENV{NTRT_VCVARS})
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Could not initialize the Visual Studio C++ environment.")
        endif()
        foreach(name IN ITEMS INCLUDE LIB LIBPATH PATH VCINSTALLDIR)
            string(REGEX MATCH "(^|\n)${name}=([^\r\n]*)" match "${environment}")
            if(name STREQUAL "PATH" AND NOT match)
                string(REGEX MATCH "(^|\n)Path=([^\r\n]*)" match "${environment}")
            endif()
            set(ENV{${name}} "${CMAKE_MATCH_2}")
        endforeach()
    endif()
    set(NTRT_VC_INSTALL_DIR "$ENV{VCINSTALLDIR}" CACHE PATH "Visual C++ installation used for deployment")

    set(launcher "${CMAKE_BINARY_DIR}/ntrt-msvc-env.cmd")
    file(WRITE "${launcher}" "@echo off\n")
    foreach(name IN ITEMS INCLUDE LIB LIBPATH PATH)
        string(REPLACE "%" "%%" value "$ENV{${name}}")
        file(APPEND "${launcher}" "@set \"${name}=${value}\"\n")
    endforeach()
    file(APPEND "${launcher}" "%*\n")
    foreach(language IN ITEMS C CXX)
        foreach(kind IN ITEMS COMPILER LINKER)
            set(CMAKE_${language}_${kind}_LAUNCHER "${launcher}" CACHE STRING "MSVC environment launcher")
        endforeach()
    endforeach()
endfunction()
