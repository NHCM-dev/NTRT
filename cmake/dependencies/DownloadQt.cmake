function(ntrt_download_qt output)
    set(deps "${CMAKE_BINARY_DIR}/_deps")
    get_filename_component(prefix "${CMAKE_CXX_COMPILER}/../.." ABSOLUTE)
    get_filename_component(triplet "${prefix}" NAME)
    set(pacman "${prefix}/../usr/bin/pacman.exe")

    if(MINGW AND EXISTS "${pacman}" AND triplet MATCHES "^(ucrt64|mingw64|clang64)$")
        if(triplet STREQUAL "ucrt64")
            set(package mingw-w64-ucrt-x86_64-qt6-base)
        elseif(triplet STREQUAL "clang64")
            set(package mingw-w64-clang-x86_64-qt6-base)
        else()
            set(package mingw-w64-x86_64-qt6-base)
        endif()
        set(sdk "${deps}/msys2-qt/${triplet}")
        if(NOT EXISTS "${sdk}/lib/cmake/Qt6/Qt6Config.cmake" OR NOT EXISTS "${sdk}/lib/cmake/Qt6WebSockets/Qt6WebSocketsConfig.cmake")
            message(STATUS "Downloading prebuilt Qt from MSYS2: ${package}")
            set(cache "${deps}/msys2-packages")
            file(MAKE_DIRECTORY "${cache}")
            string(REPLACE "-qt6-base" "-qt6-websockets" websockets_package "${package}")
            execute_process(COMMAND "${pacman}" -Sw --noconfirm --cachedir "${cache}" "${package}" "${websockets_package}"
                RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "MSYS2 Qt download failed. Update MSYS2's package database and retry, or set CMAKE_PREFIX_PATH to a compatible Qt SDK.")
            endif()
            file(GLOB archives "${cache}/*.pkg.tar.zst")
            foreach(archive IN LISTS archives)
                file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${deps}/msys2-qt"
                    PATTERNS "${triplet}/*")
            endforeach()
        endif()
    else()
        if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR CMAKE_SYSTEM_PROCESSOR MATCHES "ARM")
            message(FATAL_ERROR "Automatic Qt download currently supports Windows x64. Set CMAKE_PREFIX_PATH to your Qt SDK.")
        endif()
        if(MSVC)
            set(arch win64_msvc2022_64)
            set(folder msvc2022_64)
        elseif(MINGW AND CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "13.1.0" AND NTRT_QT_VERSION STREQUAL "6.8.3")
            set(arch win64_mingw)
            set(folder mingw_64)
        else()
            message(FATAL_ERROR "No compatible prebuilt Qt kit for this compiler. Use MSYS2 MinGW, MSVC 2022, or set CMAKE_PREFIX_PATH to a matching Qt SDK.")
        endif()
        set(sdk "${deps}/qt-sdk/${NTRT_QT_VERSION}/${folder}")
        if(NOT EXISTS "${sdk}/lib/cmake/Qt6/Qt6Config.cmake" OR NOT EXISTS "${sdk}/lib/cmake/Qt6WebSockets/Qt6WebSocketsConfig.cmake")
            find_package(Python3 REQUIRED COMPONENTS Interpreter)
            set(venv "${deps}/aqt")
            set(python "${venv}/Scripts/python.exe")
            if(NOT EXISTS "${python}")
                execute_process(COMMAND "${Python3_EXECUTABLE}" -m venv "${venv}" COMMAND_ERROR_IS_FATAL ANY)
            endif()
            execute_process(COMMAND "${python}" -m pip install --disable-pip-version-check "aqtinstall==3.3.0"
                WORKING_DIRECTORY "${deps}" COMMAND_ERROR_IS_FATAL ANY)
            message(STATUS "Downloading prebuilt Qt ${NTRT_QT_VERSION} (${arch})")
            execute_process(COMMAND "${python}" -m aqt install-qt windows desktop "${NTRT_QT_VERSION}" "${arch}"
                --modules qtwebsockets --archives qtbase qtwebsockets --outputdir "${deps}/qt-sdk"
                WORKING_DIRECTORY "${deps}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endif()

    if(NOT EXISTS "${sdk}/lib/cmake/Qt6/Qt6Config.cmake" OR NOT EXISTS "${sdk}/lib/cmake/Qt6WebSockets/Qt6WebSocketsConfig.cmake")
        message(FATAL_ERROR "Qt download did not produce a complete SDK: ${sdk}")
    endif()
    set(${output} "${sdk}" PARENT_SCOPE)
endfunction()
