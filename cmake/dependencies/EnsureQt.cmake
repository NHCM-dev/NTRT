option(NTRT_AUTO_INSTALL_QT "Download a matching prebuilt Qt SDK if needed" ON)
set(NTRT_QT_VERSION "6.8.3" CACHE STRING "Official Qt SDK version for Windows")

macro(ntrt_select_qt_sdk prefix)
    set(Qt6_DIR "${prefix}/lib/cmake/Qt6" CACHE PATH "Qt SDK package directory" FORCE)
    list(PREPEND CMAKE_PREFIX_PATH "${prefix}")
    set(ENV{PATH} "${prefix}/bin;$ENV{PATH}")
    set(_qt_selected_prefix "${prefix}")
    get_cmake_property(_qt_cache CACHE_VARIABLES)
    foreach(variable IN LISTS _qt_cache)
        if(variable MATCHES "^Qt6.+_DIR$" AND NOT "${${variable}}" STREQUAL "")
            cmake_path(IS_PREFIX _qt_selected_prefix "${${variable}}" NORMALIZE _qt_component_matches)
            if(NOT _qt_component_matches)
                unset(${variable} CACHE)
                unset(${variable})
            endif()
        endif()
    endforeach()
endmacro()

if(WIN32)
    get_filename_component(_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(_compiler_prefix "${_compiler_bin}/.." ABSOLUTE)
    get_filename_component(_triplet "${_compiler_prefix}" NAME)
    if(MINGW)
        list(PREPEND CMAKE_PREFIX_PATH "${_compiler_prefix}")
        set(ENV{PATH} "${_compiler_bin};$ENV{PATH}")
    endif()
    list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_BINARY_DIR}/_deps/qt-install")

    # Config-mode package lookup also considers prefixes inferred from PATH.
    # Mirror those prefixes so the compatibility check sees the same SDKs.
    set(_qt_hints)
    cmake_path(CONVERT "$ENV{PATH}" TO_CMAKE_PATH_LIST _qt_environment NORMALIZE)
    foreach(directory IN LISTS _qt_environment)
        get_filename_component(name "${directory}" NAME)
        if(name STREQUAL "bin")
            get_filename_component(prefix "${directory}/.." ABSOLUTE)
            list(APPEND _qt_hints "${prefix}")
        endif()
    endforeach()
    if(MSVC)
        foreach(root IN ITEMS "$ENV{MSYS2_ROOT}" "$ENV{SystemDrive}/msys64" "C:/msys64")
            if(root)
                foreach(flavor IN ITEMS ucrt64 mingw64 clang64)
                    list(APPEND CMAKE_IGNORE_PREFIX_PATH "${root}/${flavor}")
                    list(APPEND CMAKE_IGNORE_PATH "${root}/${flavor}/lib/cmake/Qt6")
                endforeach()
            endif()
        endforeach()
    endif()

    # Ignore SDKs from the other Windows compiler family before importing targets.
    while(TRUE)
        unset(_qt_candidate)
        if(EXISTS "${Qt6_DIR}/Qt6Config.cmake")
            set(_qt_candidate "${Qt6_DIR}")
        else()
            find_path(_qt_candidate Qt6Config.cmake PATHS ${_qt_hints} PATH_SUFFIXES lib/cmake/Qt6 NO_CACHE)
        endif()
        if(NOT _qt_candidate)
            break()
        endif()
        get_filename_component(_qt_prefix "${_qt_candidate}/../../.." ABSOLUTE)
        file(GLOB _gnu_qt "${_qt_prefix}/lib/libQt6Core*.dll.a")
        file(GLOB _msvc_qt "${_qt_prefix}/lib/Qt6Core*.lib")
        get_filename_component(_qt_flavor "${_qt_prefix}" NAME)
        if((MSVC AND _gnu_qt) OR (MINGW AND _msvc_qt) OR
            (MINGW AND _qt_flavor MATCHES "^(ucrt64|mingw64|clang64)$" AND NOT _qt_flavor STREQUAL _triplet))
            message(STATUS "Ignoring incompatible Qt SDK: ${_qt_prefix}")
            list(APPEND CMAKE_IGNORE_PREFIX_PATH "${_qt_prefix}")
            list(APPEND CMAKE_IGNORE_PATH "${_qt_candidate}")
            unset(Qt6_DIR CACHE)
            unset(Qt6_DIR)

        else()
            break()
        endif()
    endwhile()

    if(_qt_candidate)
        ntrt_select_qt_sdk("${_qt_prefix}")
    endif()
endif()

if(NOT WIN32 OR _qt_candidate)
    find_package(Qt6 6.5 QUIET COMPONENTS Widgets Network WebSockets)
endif()
if(NOT Qt6_FOUND AND NTRT_AUTO_INSTALL_QT AND WIN32)
    include("${CMAKE_CURRENT_LIST_DIR}/DownloadQt.cmake")
    ntrt_download_qt(_downloaded_qt)
    ntrt_select_qt_sdk("${_downloaded_qt}")
endif()
find_package(Qt6 6.5 REQUIRED COMPONENTS Widgets Network WebSockets)

get_target_property(_qt_type Qt6::Core TYPE)
if(_qt_type STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "NTRT requires shared Qt; selected Qt is static")
endif()
