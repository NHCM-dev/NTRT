if(NOT CONFIG STREQUAL "Release")
    return()
endif()
file(REAL_PATH "${BUILD_ROOT}" root)
set(destination "${root}/dist/NTRT")
set(resolved "${destination}")
if(EXISTS "${destination}")
    file(REAL_PATH "${destination}" resolved)
endif()
if(NOT resolved STREQUAL destination OR IS_SYMLINK "${root}/dist" OR IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Refusing to clear a redirected package directory")
endif()
message(STATUS "Recreating Release package: ${destination}")
file(REMOVE_RECURSE "${destination}")
file(MAKE_DIRECTORY "${destination}")
file(COPY "${APP}" DESTINATION "${destination}")
get_filename_component(app_name "${APP}" NAME)
set(APP "${destination}/${app_name}")
set(ENV{PATH} "${RUNTIME_BIN};$ENV{PATH}")
execute_process(COMMAND "${DEPLOY_TOOL}" --no-translations "${APP}" COMMAND_ERROR_IS_FATAL ANY)
include("${CMAKE_CURRENT_LIST_DIR}/DeployRuntime.cmake")
set(RESOURCE_DEST "${destination}/res")
include("${CMAKE_CURRENT_LIST_DIR}/CopyResources.cmake")
