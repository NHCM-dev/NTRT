{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (MinGW / Ninja)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/MinGW.cmake"
      },
      "generator": "Ninja"
    },
    {
      "name": "release",
      "displayName": "Release (MinGW / Ninja)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/MinGW.cmake"
      },
      "generator": "Ninja"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}
